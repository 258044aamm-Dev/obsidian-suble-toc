{
	"name": "subtle-toc",
	"version": "0.7.1-beta.1",
	"description": "A floating, Capacities-style table of contents for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"sim": "node sim/build.mjs && echo built",
		"sim:watch": "node sim/build.mjs watch",
		"verify": "node verify.mjs",
		"verify:shots": "node verify.mjs --shots"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"table-of-contents",
		"toc",
		"outline"
	],
	"author": "xupisco",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/view": "^6.0.0",
		"@types/node": "^20.11.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"playwright-core": "^1.48.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0",
		"vitest": "^2.1.9"
	}
}
